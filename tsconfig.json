{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Spec 01 (platform upgrade) — `baseUrl` was dropped: TypeScript 6
    // deprecates it, and `paths` resolves relative to this file without it.
    // The explicit `"module": "esnext"` override (QA Audit Fix Plan, Chunk F)
    // was also dropped: expo/tsconfig.base (SDK 58) now sets
    // `"module": "preserve"`, which already allows the dynamic `import()`
    // calls in officeAction.test.ts that the override existed for.
    // TypeScript 6 no longer auto-includes every installed @types package,
    // so the ambient globals the test suite and scripts rely on are listed.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
